+	inline std::vector<CJSEmbedObject*>* EmbedObjectRegistry(v8::Isolate* isolate)
+	{
+		return static_cast<std::vector<CJSEmbedObject*>*>(isolate->GetData(0));
+	}
+
+	inline void TrackEmbedObject(v8::Isolate* isolate, CJSEmbedObject* object)
+	{
+		std::vector<CJSEmbedObject*>* registry = EmbedObjectRegistry(isolate);
+		if (!registry)
