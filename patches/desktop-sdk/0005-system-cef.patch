new file mode 100644
index 00000000..7f1cc565
--- /dev/null
+++ b/ChromiumBasedEditors/lib/src/cef_compat_types.h
@@ -0,0 +1,10 @@
+#pragma once
+#include <stdint.h>
+
+// CEF 109 exposed int64 / uint32 / uint64. CEF 155 has only the stdint names.
+// These are real typedefs, included by the editor sources that still use the
+// old names. A -D macro would rewrite the same tokens inside POLE, agg and
+// tiff, which define those names themselves.
+typedef int64_t int64;
+typedef uint32_t uint32;
+typedef uint64_t uint64;
